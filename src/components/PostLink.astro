---
interface Props {
  title: string;
  description: string;
  date: string;
  tags: string[];
  href: string;
}

const { title, description, date, tags, href } = Astro.props;
---

<li>
  <div
    class="block mt-6 p-6 rounded-lg border shadow-md bg-gray-800 border-gray-700"
  >
    <h3>
      <a
        href={href}
        class="block underline hover:text-emerald-700 mb-4 text-2xl font-semibold tracking-tight text-white"
      >
        {title}
      </a>
    </h3>
    <h4 class="font-normal text-white mb-4">{description}</h4>
    <p class="text-emerald-500">{date}</p>
    {
      tags && tags.length > 0 && (
        <ul class="flex gap-2 flex-wrap mt-4">
          {tags.map((tag) => (
            <li class="text-white hover:bg-emerald-700 hover:underline mb-2 border-solid border rounded-full text-sm p-2 leading-3 border-gray">
              <a href={`/tags/${tag.trim().toLowerCase().replace(" ", "-")}/`}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</li>
