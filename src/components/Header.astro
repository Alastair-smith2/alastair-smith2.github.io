---
import MenuList from "./MenuList.astro";
import Search from "astro-pagefind/components/Search";

const items = [
  { href: "/", text: "Home" },
  { href: "/posts/", text: "Posts" },
  { href: "/about/", text: "About" },
];

---

<header
  class="flex flex-col sm:flex-row sm:justify-between p-6 sm:mb-5 lg:mb-6 row-end-1"
>
  <div class="sm:basis-1/3 content-center">
    <a href="/">
      <h1 class="text-3xl text-emerald-500 hover:text-emerald-300">
        Alastair Smith
      </h1>
    </a>
  </div>
  <div class="mt-3 w-full">
    <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false, excerptLength: 20, debounceTimeoutMs: 500, showSubResults: true }} />
  </div>
  <MenuList items={items} />
</header>
