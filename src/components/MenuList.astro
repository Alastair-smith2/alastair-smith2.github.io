---
import MenuLink from "./MenuLink.astro";

export type Style = "button" | "link";

interface MenuItem {
  href: string;
  text: string;
}

interface Props {
  items: MenuItem[];
  style?: Style;
}

const { items, style = "link" } = Astro.props;
---

<ul
  class="mt-3 sm:mt-0 basis-1/3 flex flex-row sm:justify-end"
>
  {items.map((item) => <MenuLink style={style} item={item} />)}
</ul>
