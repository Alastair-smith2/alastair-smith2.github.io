{
  "name": "alastairs-blog",
  "description": "Alastair's blog built with Astro",
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build.types": "astro check && tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint src/**/*.ts src/**/*.astro",
    "prepare": "husky install",
    "test": "npx playwright test tests/"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": "eslint --fix"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.6.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "latest",
    "autoprefixer": "10.4.14",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.14.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.16",
    "prettier": "2.7.1",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.10.1",
    "remark-gfm": "^4.0.0",
    "shiki": "^0.14.4",
    "tailwindcss": "^4.1.18",
    "typescript": "5.1.6",
    "typescript-eslint": "^8.21.0"
  }
}
